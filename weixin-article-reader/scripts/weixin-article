#!/bin/sh
set -eu

reader_bin="${WEIXIN_ARTICLE_BIN:-$HOME/.vibelab-tools/agent-skills/weixin-article-reader/bin/weixin-article}"
if [ ! -x "$reader_bin" ]; then
    printf '%s\n' "weixin-article runtime not found: run make -C weixin-article-reader install-runtime" >&2
    exit 1
fi
exec "$reader_bin" "$@"
