{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "evaluations", "ranking", "best", "confidence", "limitations"],
  "properties": {
    "case_id": {"type": "string"},
    "evaluations": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "naturalness", "reader_clarity", "register_fit", "claims", "added_claims", "rationale"],
        "properties": {
          "label": {"type": "string"},
          "naturalness": {"type": "integer", "minimum": 1, "maximum": 5},
          "reader_clarity": {"type": "integer", "minimum": 1, "maximum": 5},
          "register_fit": {"type": "integer", "minimum": 1, "maximum": 5},
          "claims": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "status", "evidence"],
              "properties": {
                "id": {"type": "string"},
                "status": {"type": "string", "enum": ["intact", "altered", "dropped"]},
                "evidence": {"type": "string"}
              }
            }
          },
          "added_claims": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["claim", "evidence"],
              "properties": {
                "claim": {"type": "string"},
                "evidence": {"type": "string"}
              }
            }
          },
          "rationale": {"type": "string"}
        }
      }
    },
    "ranking": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {"type": "string"}
    },
    "best": {"type": "string"},
    "confidence": {"type": "string", "enum": ["low", "medium", "high"]},
    "limitations": {"type": "string"}
  }
}
